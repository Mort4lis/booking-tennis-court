# Copy to .env and adjust. All variables are prefixed with BTC_.
# `serve` needs BTC_TELEGRAM_* and BTC_POSTGRES_*; `migrate` needs only BTC_POSTGRES_*.

# --- Telegram (long polling) ---
BTC_TELEGRAM_TOKEN=
BTC_TELEGRAM_DEBUG=false

# --- PostgreSQL ---
BTC_POSTGRES_DSN=postgres://booking:booking@localhost:5432/booking?sslmode=disable
BTC_POSTGRES_MAX_CONNS=10
BTC_POSTGRES_MIN_CONNS=2
BTC_POSTGRES_MAX_CONN_LIFETIME=1h
BTC_POSTGRES_MAX_CONN_IDLE_TIME=30m

# --- Logging ---
BTC_LOG_LEVEL=info   # debug | info | warn | error
BTC_LOG_FORMAT=json  # json | text

# --- Metrics (OpenTelemetry -> Prometheus endpoint) ---
BTC_METRICS_ENABLED=true
BTC_METRICS_ADDR=:9090
BTC_METRICS_PATH=/metrics

# --- Tracing (OpenTelemetry over OTLP/gRPC; `make compose-up` starts a local Jaeger, UI on :16686) ---
BTC_TRACING_ENABLED=false
BTC_TRACING_OTLP_ENDPOINT=localhost:4317
BTC_TRACING_SERVICE_NAME=booking-tennis-court
